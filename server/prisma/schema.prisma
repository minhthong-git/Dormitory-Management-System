generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlserver"
}

// ── NOTE: SQL Server không hỗ trợ enum trong Prisma ──────────────
// Dùng String + @default + check constraint bằng code/middleware

// ── Models ─────────────────────────────────────────────────────

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  fullName  String
  studentId String?  @unique
  phone     String?
  avatarUrl String?
  /// Allowed values: STUDENT | STAFF | ADMIN
  role                String    @default("STUDENT")
  /// Allowed values: ACTIVE | PENDING | REJECTED | BANNED
  status              String    @default("ACTIVE")
  failedLoginCount    Int       @default(0)
  lockedUntil         DateTime?
  verificationToken   String?
  verificationExpires DateTime?
  resetPasswordToken   String?
  resetPasswordExpires DateTime?
  resetPasswordLastSent DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt


  notifications Notification[]
  student       Student?
  assignedMaintenances MaintenanceRequest[] @relation("StaffMaintenance")

  @@map("users")
}

model Room {
  id               String   @id @default(uuid())
  roomNumber       String   @unique
  floor            Int
  capacity         Int
  currentOccupancy Int      @default(0)
  /// Allowed values: SMALL | STANDARD | LARGE
  type             String
  /// Allowed values: MALE | FEMALE
  genderType       String   @default("MALE")
  /// Allowed values: AVAILABLE | FULL | MAINTENANCE
  status           String   @default("AVAILABLE")
  pricePerMonth    Float
  description      String?
  buildingId       String
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  building        Building         @relation(fields: [buildingId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  utilityReadings UtilityReading[]
  invoices        Invoice[]
  beds            Bed[]
  assets          Asset[]
  maintenanceRequests MaintenanceRequest[]

  @@map("rooms")
}

model Student {
  id               String    @id @default(uuid())
  userId           String?   @unique
  studentCode      String    @unique
  fullName         String
  /// Allowed values: MALE | FEMALE | OTHER
  gender           String
  dateOfBirth      DateTime?
  email            String    @unique
  phone            String?
  faculty          String?
  major            String?
  course           String?
  emergencyContact String?
  emergencyPhone   String?
  /// Allowed values: ACTIVE | INACTIVE
  status           String    @default("ACTIVE")
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  user      User?      @relation(fields: [userId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  contracts Contract[]
  transferHistories TransferHistory[]
  maintenanceRequests MaintenanceRequest[]

  @@map("students")
}

model Bed {
  id        String @id @default(uuid())
  roomId    String
  bedNumber Int
  bedType   String @default("SINGLE")
  /// Allowed values: AVAILABLE | OCCUPIED | MAINTENANCE
  status    String @default("AVAILABLE")

  room      Room      @relation(fields: [roomId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  contracts Contract[]
  transferHistoriesOld TransferHistory[] @relation("TransferOldBed")
  transferHistoriesNew TransferHistory[] @relation("TransferNewBed")

  @@unique([roomId, bedNumber])
  @@map("beds")
}

model Contract {
  id        String   @id @default(uuid())
  studentId String
  bedId     String
  startDate DateTime
  endDate   DateTime
  price     Float
  deposit    Float    @default(0)
  monthlyFee Float    @default(0)
  /// Allowed values: ACTIVE | EXPIRED | TERMINATED
  status    String   @default("ACTIVE")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  student           Student          @relation(fields: [studentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  bed               Bed              @relation(fields: [bedId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  invoices          Invoice[]
  transferHistories TransferHistory[]

  @@map("contracts")
}

model TransferHistory {
  id        String   @id @default(uuid())
  contractId String
  studentId String
  oldBedId  String
  newBedId  String
  reason    String?
  createdAt DateTime @default(now())

  contract Contract @relation(fields: [contractId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  student  Student  @relation(fields: [studentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  oldBed   Bed      @relation("TransferOldBed", fields: [oldBedId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  newBed   Bed      @relation("TransferNewBed", fields: [newBedId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@map("transfer_histories")
}

model Invoice {
  id            String    @id @default(uuid())
  roomId        String
  contractId    String?
  billingMonth  Int
  billingYear   Int
  roomFee       Float
  electricityFee Float
  waterFee      Float
  serviceFee    Float
  totalAmount   Float
  /// Allowed values: UNPAID | PARTIAL | PAID | OVERDUE
  paymentStatus String    @default("UNPAID")
  dueDate       DateTime
  paidDate      DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  room          Room          @relation(fields: [roomId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  contract      Contract?     @relation(fields: [contractId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([roomId, billingMonth, billingYear])
  @@index([roomId])
  @@index([contractId])
  @@map("invoices")
}

model Building {
  id          String   @id @default(uuid())
  name        String   @unique
  genderType  String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  rooms Room[]

  @@map("buildings")
}
model UtilityReading {
  id               String   @id @default(uuid())
  roomId           String
  billingMonth     Int
  billingYear      Int
  previousElectric Float
  currentElectric  Float
  electricUsed     Float
  previousWater    Float
  currentWater     Float
  waterUsed        Float
  electricPrice    Float
  waterPrice       Float
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  room             Room     @relation(fields: [roomId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([roomId, billingMonth, billingYear])
  @@index([roomId])
  @@map("utility_readings")
}

model Notification {
  id          String   @id @default(uuid())
  userId      String
  /// Allowed values: INVOICE_CREATED | INVOICE_PAID | INVOICE_OVERDUE | CONTRACT_CREATED | CONTRACT_TERMINATED | CONTRACT_EXPIRING | UTILITY_RECORDED | PAYMENT_REMINDER | SYSTEM
  type        String
  /// Allowed values: LOW | MEDIUM | HIGH | URGENT
  priority    String   @default("MEDIUM")
  title       String
  message     String
  isRead      Boolean  @default(false)
  /// Optional link to related entity (e.g., invoice ID, contract ID)
  referenceId String?
  /// Allowed values: INVOICE | CONTRACT | UTILITY | ROOM | SYSTEM
  referenceType String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user        User     @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([userId])
  @@index([userId, isRead])
  @@index([createdAt])
  @@map("notifications")
}

model Asset {
  id          String   @id @default(uuid())
  name        String
  code        String   @unique
  type        String
  status      String   @default("GOOD")
  description String?
  roomId      String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  room        Room     @relation(fields: [roomId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  maintenanceRequests MaintenanceRequest[]

  @@map("assets")
}

model MaintenanceRequest {
  id          String   @id @default(uuid())
  roomId      String
  assetId     String?
  studentId   String
  title       String
  description String
  status      String   @default("PENDING")
  priority    String   @default("MEDIUM")
  damageSeverity String   @default("NORMAL")
  staffId     String?
  notes       String?
  resolvedAt  DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  room        Room     @relation(fields: [roomId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  asset       Asset?   @relation(fields: [assetId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  student     Student  @relation(fields: [studentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  staff       User?    @relation("StaffMaintenance", fields: [staffId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@map("maintenance_requests")
}

