model Contract {
  id        String   @id @default(uuid())
  userId    String
  roomId    String
  startDate DateTime
  endDate   DateTime
  /// Allowed values: ACTIVE | EXPIRED | TERMINATED
  status    String   @default("ACTIVE")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User      @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  room     Room      @relation(fields: [roomId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  invoices Invoice[]

  @@map("contracts")
}

model Invoice {
  id            String    @id @default(uuid())
  roomId        String
  contractId    String?
  billingMonth  Int
  billingYear   Int
  roomFee       Float
  electricityFee Float
  waterFee      Float
  serviceFee    Float
  totalAmount   Float
  /// Allowed values: UNPAID | PARTIAL | PAID | OVERDUE
  paymentStatus String    @default("UNPAID")
  dueDate       DateTime
  paidDate      DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  room          Room          @relation(fields: [roomId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  contract      Contract?     @relation(fields: [contractId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([roomId, billingMonth, billingYear])
  @@index([roomId])
  @@index([contractId])
  @@map("invoices")
}

model Building {
  id          String   @id @default(uuid())
  name        String   @unique
  genderType  String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  rooms Room[]

  @@map("buildings")
}
model UtilityReading {
  id               String   @id @default(uuid())
  roomId           String
  billingMonth     Int
  billingYear      Int
  previousElectric Float
  currentElectric  Float
  electricUsed     Float
  previousWater    Float
  currentWater     Float
  waterUsed        Float
  electricPrice    Float
  waterPrice       Float
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  room             Room     @relation(fields: [roomId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([roomId, billingMonth, billingYear])
  @@index([roomId])
  @@map("utility_readings")
}

model Notification {
  id          String   @id @default(uuid())
  userId      String
  /// Allowed values: INVOICE_CREATED | INVOICE_PAID | INVOICE_OVERDUE | CONTRACT_CREATED | CONTRACT_TERMINATED | CONTRACT_EXPIRING | UTILITY_RECORDED | PAYMENT_REMINDER | SYSTEM
  type        String
  /// Allowed values: LOW | MEDIUM | HIGH | URGENT
  priority    String   @default("MEDIUM")
  title       String
  message     String
  isRead      Boolean  @default(false)
  /// Optional link to related entity (e.g., invoice ID, contract ID)
  referenceId String?
  /// Allowed values: INVOICE | CONTRACT | UTILITY | ROOM | SYSTEM
  referenceType String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user        User     @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([userId])
  @@index([userId, isRead])
  @@index([createdAt])
  @@map("notifications")
}

