generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlserver"
  url      = env("DATABASE_URL")
}

// ── NOTE: SQL Server không hỗ trợ enum trong Prisma ──────────────
// Dùng String + @default + check constraint bằng code/middleware

// ── Models ─────────────────────────────────────────────────────

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  fullName  String
  studentId String?  @unique
  phone     String?
  avatarUrl String?
  /// Allowed values: STUDENT | STAFF | ADMIN
  role      String   @default("STUDENT")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  contracts     Contract[]
  notifications Notification[]

  @@map("users")
}

