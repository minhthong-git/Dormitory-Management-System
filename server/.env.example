# ── Server ──────────────────────────────────────────────────────
NODE_ENV=development
PORT=5000

# ── Database (Prisma) ────────────────────────────────────────────
# PostgreSQL (recommended):
DATABASE_URL="postgresql://user:password@localhost:5432/dormitory_db?schema=public"
# SQL Server:
# DATABASE_URL="sqlserver://localhost:1433;database=DormitoryDB;user=sa;password=YourStrong@Passw0rd;trustServerCertificate=true"
# MySQL:
# DATABASE_URL="mysql://user:password@localhost:3306/dormitory_db"

# ── JWT ──────────────────────────────────────────────────────────
JWT_ACCESS_SECRET=your-very-long-super-secret-access-key-change-me
JWT_REFRESH_SECRET=your-very-long-super-secret-refresh-key-change-me
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ── CORS ─────────────────────────────────────────────────────────
CLIENT_URL=http://localhost:5173

# ── File Upload ──────────────────────────────────────────────────
MAX_FILE_SIZE_MB=5
UPLOAD_DIR=uploads
