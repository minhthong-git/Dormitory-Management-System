              "raw": "{\n  \"currentElectric\": 1430,\n  \"currentWater\": 448\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/utilities/{{readingId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "utilities", "{{readingId}}"]
            }
