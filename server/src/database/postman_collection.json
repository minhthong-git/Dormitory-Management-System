        },
        {
          "name": "Delete Reading",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/utilities/{{readingId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "utilities", "{{readingId}}"]
            }
          }
        },
        {
          "name": "Estimate Utility Costs",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"roomFee\": 1200000,\n  \"previousElectric\": 1260,\n  \"currentElectric\": 1420,\n  \"previousWater\": 428,\n  \"currentWater\": 445,\n  \"electricPrice\": 3500,\n  \"waterPrice\": 15000,\n  \"serviceFee\": 50000\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/utilities/calculate",
              "host": ["{{baseUrl}}"],
              "path": ["api", "utilities", "calculate"]
            }
          }
        }
      ]
    }
  ]
}
